<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.karaokeplayer.LandingPage"
            prefHeight="400.0" prefWidth="600.0">

    <VBox alignment="CENTER" spacing="20.0" layoutX="150.0" layoutY="100.0">
        <children>
            <Text text="🎤 Welcome to Karaoke Player!" style="-fx-font-size: 24px;" />
            <Button text="Enter Player" onAction="#enterPlayer" prefWidth="200" />
        </children>
    </VBox>
</AnchorPane>
